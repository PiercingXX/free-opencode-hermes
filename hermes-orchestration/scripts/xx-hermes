#!/usr/bin/env bash
# Thin Unix wrapper around xx_hermes.py (Linux/macOS). Windows uses xx-hermes.cmd.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
if command -v python3 >/dev/null 2>&1; then
  exec python3 "$HERE/xx_hermes.py" "$@"
fi
exec python "$HERE/xx_hermes.py" "$@"
