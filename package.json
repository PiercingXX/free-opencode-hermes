{
  "name": "free-opencode-hermes",
  "version": "1.66.0",
  "description": "OpenCode plugin: multi-provider routing plus the xx-stack agent runtime",
  "private": true,
  "//type": "Intentionally NOT \"module\". Shared helpers under xx-stack/scripts/*.js are CommonJS; ESM entrypoints use the .mjs extension. Workspaces declare their own type.",
  "workspaces": [
    "xx-stack/mcp-server",
    "packages/plugin"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "eslint . --ext .ts,.mjs,.js",
    "lint:fix": "eslint . --ext .ts,.mjs,.js --fix",
    "typecheck": "npm --prefix xx-stack/mcp-server run build -- --noEmit && npm run typecheck -w free-opencode",
    "format": "prettier --write \"{xx-stack/mcp-server/src,xx-stack/scripts,packages/plugin/src,scripts}/**/*.{ts,js,mjs}\"",
    "format:check": "prettier --check \"{xx-stack/mcp-server/src,xx-stack/scripts,packages/plugin/src,scripts}/**/*.{ts,js,mjs}\"",
    "plugin:build": "npm run build -w free-opencode",
    "plugin:test": "npm test -w free-opencode",
    "layout:verify": "npm run layout:verify:core && npm run layout:verify:opencode",
    "layout:verify:core": "node xx-stack/scripts/verify-repo-layout.mjs xx-stack",
    "layout:verify:opencode": "node xx-stack/scripts/verify-repo-layout.mjs opencode-orchestration",
    "design:catalog": "node xx-stack/scripts/generate-design-catalog.mjs",
    "design:golden": "node xx-stack/scripts/evaluate-golden-tasks.mjs",
    "design:html-gate": "node xx-stack/scripts/quality-gate-html.mjs",
    "design:systems-lint": "node xx-stack/packs/design/scripts/lint-design-systems.mjs",
    "hermes:test": "cd hermes-orchestration && python3 -m unittest discover -s tests",
    "verify": "npm run layout:verify && npm run drift:check && npm run rules:check && npm run nano:check && npm run inventory:check && npm run guardrails:check && npm run ci:parity && npm run lint && npm run format:check && npm run design:golden && npm run design:html-gate && npm run design:systems-lint && npm run design:craft-refs && npm run design:anti-slop-test && npm test && npm run hermes:test && npm run plugin:test",
    "drift:check": "node xx-stack/scripts/check-stack-source-drift.mjs",
    "rules:check": "node xx-stack/scripts/check-rules-coverage.mjs",
    "nano:check": "node xx-stack/scripts/check-nano-tiers.mjs",
    "guardrails:check": "node xx-stack/scripts/check-dangerous-patterns.mjs",
    "ci:parity": "node xx-stack/scripts/check-ci-parity.mjs",
    "inventory:sync": "node xx-stack/scripts/generate-registries.mjs",
    "inventory:check": "node xx-stack/scripts/generate-registries.mjs --check",
    "inventory:scan": "node xx-stack/scripts/scan-tailscale.mjs",
    "inventory:list": "node xx-stack/scripts/toggle-lane.mjs list",
    "inventory:enable": "node xx-stack/scripts/toggle-lane.mjs enable",
    "inventory:disable": "node xx-stack/scripts/toggle-lane.mjs disable",
    "design:craft-refs": "node xx-stack/packs/design/scripts/check-craft-references.mjs",
    "design:anti-slop-test": "node xx-stack/packs/design/scripts/test-anti-slop-rules.mjs"
  },
  "keywords": [
    "mcp",
    "agents",
    "autonomous",
    "routing",
    "self-hosted",
    "opencode"
  ],
  "author": "xx-stack contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^10.9.1",
    "prettier": "^3.5.3",
    "typescript": "^7.0.2"
  }
}
